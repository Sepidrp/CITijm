<?xml version="1.0" encoding="utf-8"?>
<style xmlns="http://purl.org/net/xbiblio/csl"
       version="1.0"
       class="in-text"
       default-locale="en-US">
  <info>
    <title>International Journal of Minerals, Metallurgy and Materials - Exact Author Guidelines</title>
    <title-short>IJMMM Exact</title-short>
    <id>http://www.zotero.org/styles/ijmmm-exact-custom</id>
    <link href="http://www.zotero.org/styles/ijmmm-exact-custom" rel="self"/>
    <updated>2026-10-04T00:00:00+00:00</updated>
    <summary>Custom CSL style matching the IJMMM reference examples supplied by the user.</summary>
    <rights license="http://creativecommons.org/licenses/by-sa/3.0/"/>
  </info>

  <locale xml:lang="en">
    <terms>
      <term name="and">and</term>
      <term name="page">p.</term>
      <term name="page-range-delimiter">-</term>
    </terms>
  </locale>

  <macro name="author">
    <names variable="author">
      <name initialize-with="."
            name-as-sort-order="never"
            delimiter=", "
            and="text"
            delimiter-precedes-last="always"
            sort-separator=", "/>
      <substitute>
        <text variable="title"/>
      </substitute>
    </names>
  </macro>

  <macro name="editor">
    <names variable="editor">
      <name initialize-with="."
            name-as-sort-order="never"
            delimiter=", "
            and="text"
            delimiter-precedes-last="always"/>
      <label prefix=", " form="short"/>
    </names>
  </macro>

  <macro name="year">
    <date variable="issued">
      <date-part name="year"/>
    </date>
  </macro>

  <macro name="journal">
    <text variable="container-title" form="short" font-style="italic"/>
  </macro>

  <macro name="pages">
    <group delimiter=" ">
      <label variable="page" form="short"/>
      <text variable="page"/>
    </group>
  </macro>

  <macro name="publisher">
    <group delimiter=", ">
      <text variable="publisher"/>
      <text variable="publisher-place"/>
    </group>
  </macro>

  <citation collapse="citation-number">
    <layout prefix="[" suffix="]" delimiter=", ">
      <text variable="citation-number"/>
    </layout>
  </citation>

  <bibliography second-field-align="flush"
                entry-spacing="0"
                line-spacing="1"
                et-al-min="999"
                et-al-use-first="999">
    <layout suffix=".">
      <text variable="citation-number" prefix="[" suffix="] "/>

      <choose>

        <!-- Journal articles -->
        <if type="article-journal" match="any">
          <text macro="author" suffix=", "/>
          <text variable="title" suffix=", "/>
          <group delimiter="">
            <text macro="journal"/>
            <text variable="volume" prefix=", " suffix=""/>
            <text macro="year" prefix="(" suffix="), "/>
          </group>
          <text variable="issue" prefix="No. " suffix=", "/>
          <text macro="pages"/>
        </if>

        <!-- Books / monographs -->
        <else-if type="book" match="any">
          <text macro="author" suffix=", "/>
          <text variable="title" font-style="italic" suffix=", "/>
          <text macro="publisher" suffix=", "/>
          <text macro="year" suffix=", "/>
          <text macro="pages"/>
        </else-if>

        <!-- Conference proceedings / chapters in proceedings -->
        <else-if type="paper-conference" match="any">
          <text macro="author" suffix=", "/>
          <text variable="title" suffix=", [in] "/>
          <text variable="container-title" font-style="italic" suffix=", "/>
          <text macro="editor" prefix="" suffix=", "/>
          <text variable="publisher-place" suffix=", "/>
          <text macro="year" suffix=", "/>
          <text macro="pages"/>
        </else-if>

        <!-- Thesis / dissertation -->
        <else-if type="thesis" match="any">
          <text macro="author" suffix=", "/>
          <text variable="title" font-style="italic" suffix=" "/>
          <text variable="genre" prefix="[" suffix="], "/>
          <text macro="publisher" suffix=", "/>
          <text macro="year" suffix=", "/>
          <text macro="pages"/>
        </else-if>

        <!-- Patents -->
        <else-if type="patent" match="any">
          <text macro="author" suffix=", "/>
          <text variable="title" font-style="italic" suffix=", "/>
          <text variable="authority" suffix=", "/>
          <text variable="number" prefix="Appl. " suffix=", "/>
          <text macro="year"/>
        </else-if>

        <!-- Reports -->
        <else-if type="report" match="any">
          <text macro="author" suffix=", "/>
          <text variable="title" font-style="italic" suffix=", "/>
          <text variable="genre" suffix=", "/>
          <text macro="publisher" suffix=", "/>
          <text macro="year" suffix=", "/>
          <text macro="pages"/>
        </else-if>

        <!-- Electronic / web publications represented as article -->
        <else-if type="webpage" match="any">
          <text macro="author" suffix=", "/>
          <text variable="title" suffix=", "/>
          <text variable="container-title" font-style="italic" suffix=", "/>
          <text macro="year"/>
          <text variable="URL" prefix=". Available at: "/>
        </else-if>

        <!-- Generic fallback -->
        <else>
          <text macro="author" suffix=", "/>
          <text variable="title" suffix=", "/>
          <text variable="container-title" font-style="italic" suffix=", "/>
          <text macro="year"/>
        </else>

      </choose>
    </layout>
  </bibliography>
</style>
